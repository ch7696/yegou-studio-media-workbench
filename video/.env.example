# WebUI 配置
WEBUI_HOST=0.0.0.0
WEBUI_PORT=7877
MEDIA_OUTPUT_ROOT=./outputs
WEBUI_STATE=./state

# 视觉模型服务
MINICPM_CONTAINER=vision-minicpm
MINICPM_PORT=8002
MINICPM_URL=http://127.0.0.1:8002/v1/chat/completions
MINICPM_HEALTH_URL=http://127.0.0.1:8002/health
MINICPM_STARTUP_TIMEOUT=600
# 下列覆盖项通常留空，由 config/models.json 按所选模型提供。
# 显式设置后会覆盖模型注册表，切换模型时也会继续生效。
# MINICPM_MODEL=MiniCPM-V-4_5-GPTQ
# MINICPM_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/vllm/vllm-openai:v0.26.0
# MINICPM_MAX_MODEL_LEN=32768
# MINICPM_GPU_MEMORY_UTILIZATION=0.90
# MINICPM_MAX_IMAGES=8
# 4.7 默认启用编译与 CUDA Graph；设为 1 可回退 eager 调试。
# MINICPM_ENFORCE_EAGER=1
# MINICPM_RUNTIME_CACHE_DIR=/home/administrator/.cache/minicpm-v47
# 4.7-1B 导演拉片默认用 evidence-v1；设为 legacy 可回退旧提示词。
# DIRECTOR_PROMPT_PROFILE=legacy
MODEL_ROOT=/home/administrator/models
RELEASE_GPU_AFTER_JOB=0

# ASR 与 ForcedAligner 服务
ASR_IMAGE=ragflow-qwen-asr:0.0.6
ASR_CONTAINER=vision-asr
ASR_MAX_NEW_TOKENS=2048
# auto：4.7-1B 复用常驻 ASR/对齐模型；其他模型使用顺序释放模式。
ASR_EXECUTION_MODE=auto
ASR_RESIDENT_CONTAINER=vision-audio-resident
ASR_RESIDENT_PORT=8003
